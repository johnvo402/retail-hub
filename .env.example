# PostgreSQL
POSTGRES_DB=retailhub
POSTGRES_USER=retailhub
POSTGRES_PASSWORD=retailhub_dev
DB_URL=jdbc:postgresql://localhost:5432/retailhub
DB_USERNAME=retailhub
DB_PASSWORD=retailhub_dev

# Redis and Elasticsearch
REDIS_HOST=localhost
REDIS_PORT=6379
ELASTICSEARCH_URL=http://localhost:9200

# Authentication (replace in every non-local environment; at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=1209600
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=

# Browser/API integration
CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_URL=/api

# Optional development-only initial administrator
ADMIN_EMAIL=admin@retailhub.local
ADMIN_PASSWORD=RetailHub123!
