# Public entry point. Terminate HTTPS in front of this port in production.
FRONTEND_PORT=80
PUBLIC_ORIGIN=

# Immutable images produced by the main-branch CD workflow. The deployment script
# overrides these values with the requested 40-character Git commit SHA.
BACKEND_IMAGE=ghcr.io/johnvo402/retail-hub-backend:replace-with-git-sha
FRONTEND_IMAGE=ghcr.io/johnvo402/retail-hub-frontend:replace-with-git-sha

# PostgreSQL. Set a strong unique password before starting the stack.
POSTGRES_DB=retailhub
POSTGRES_USER=retailhub
POSTGRES_PASSWORD=

# Authentication. Generate a random secret with at least 32 characters.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=1209600
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=

# Cache and Elasticsearch process sizing.
PRODUCT_CACHE_TTL=10m
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Optional one-time administrator bootstrap. Leave both blank to disable it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
